author = {Wang, Duanlian and Huang, Wei and Xiong, Qi and Wen, Zhiyuan},
title = {Load Prediction of Exhaust Gas Treatment System Based on Genetic Algorithm Optimization Neural Network},
year = {2024},
isbn = {9798400708039},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
