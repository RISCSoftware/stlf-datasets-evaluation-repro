@article{10.1007/s42979-023-02182-5,
author = {Kothai Andal, C. and Jayapal, R.},
title = {Intelligent Power and Cost Management System in Small-Scale Grid-Associated PV-Wind Energy System Using RNN-LSTM},
year = {2023},
issue_date = {Oct 2023},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
volume = {4},
number = {6},
url = {https://doi.org/10.1007/s42979-023-02182-5},
doi = {10.1007/s42979-023-02182-5},
abstract = {Renewable hybrids are crucial for India’s efforts to accelerate the de-carbonization of power generation and, in the medium term, reduce the cost of power generation. Due to the complimentarily of PV and wind energy, the system can provide power for virtually the entire season. This research analyses a PV-wind energy system that is connected to the grid and powered by a battery. The sources that should be efficiently planned for uninterrupted power and cost reduction are PV, wind, grid, and batteries. The most important factor in making optimum use of the energy sources at hand is smart grid analysis. Through the use of digital technology, the utility and the customer may communicate in both directions. Analog and digital data technologies are used to the electrical grid. However, the use of renewable energy makes this a significant study field. This is due to the fact that renewable energy is environmentally beneficial, and given how it can be used in a smart grid, the grid becomes much more promising. Renewable energy is more effective because of the smart grid integration. Examining the function of the smart grid in the energy sector is now the high priority this review article tries to address. The paper's introduction examines the grid system and the many steps elaborate in the production to distribution progression. Sections analyze the availability of various renewable sources. Energy management systems and other smart gadgets have been discussed. IoT technology was applied in smart grid system to produce the sustainable energy also covered. It features sophisticated switching and sensing devices of balancing the load and peak flake, in contrast to the conventional power grid. In SG systems, numerous electrical appliances and smart gadgets installed in smart buildings periodically produce data about energy consumption, occupancy trends, or end-user movements. Using an efficient data pre-processing and data analytics technique, this data may be evaluated to identify important energy patterns that can be used to demand response management, load forecasting, and peak shaving. One of the primary issues with SG systems, however, is developing an integrated method for pre-processing and data analysis that has lower error rates and higher accuracy. This study uses a comprehensive approach based on deep learning and recurrent neural networks to overcome the aforementioned problems (RNN). The Long Short-Term Memory (LSTM) model is then applied to the pre-processed, high-order singular value decomposition data that is collected from smart homes.},
journal = {SN Comput. Sci.},
month = sep,
numpages = {10},
keywords = {Long Short-Term Memory (LSTM), Renewable energy, IoT, PV-wind energy, Recurrent neural networks (RNN)}
}

