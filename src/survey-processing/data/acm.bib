year = {2022},
isbn = {9781450386494},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3513142.3513183},
doi = {10.1145/3513142.3513183},
abstract = {The configuration of a substation automation system is often described by SCD files in order to achieve interoperability between intelligent electrical devices. Although several SCD configuration software exist in the market, their query functions are not flexible and convenient, indicating steep learning curve for novice designers and engineers. Therefore, a natural language interface might be useful for more efficient query of SCD files. Accordingly, the method for converting a SCD file into the Neo4J graph database is first developed, and then the method to convert the natural language sentences to Cypher codes is also studied. The query results of the experiment on a real design case indicate that the proposed methods can reduce the difficulty of querying SCD files.},
