@inproceedings{10.1007/978-981-99-4752-2_14,
author = {Wang, Zi and Zhang, Tao and Zeng, Sheng and Wang, Bing},
title = {Research on Double Input Electric Load Forecasting Model Based on Feature Fusion},
year = {2023},
isbn = {978-981-99-4751-5},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-99-4752-2_14},
doi = {10.1007/978-981-99-4752-2_14},
abstract = {Electric load forecasting is a relatively basic work in the world’s power industry, which has an important impact on the operation of the control power system. With the development of social production, the electricity consumption in people’s daily life, factories and enterprises is continuously increasing, it also increases the difficulty of electric load forecasting. Traditional methods are difficult to analyze the huge and complex electricity consumption data. Moreover, the existing methods cannot fully learn the potential information of the data. To solve these problems, this research proposes a deep learning-based method which has the double input structure of Conv1D + Attention+GRU and BP network. These two structures are used to extract the time series characteristics of electric load data and the characteristics of meteorological factor data respectively. Performing feature fusion at the output end of the two structures, obtaining the prediction results of future electric load data through sigmoid function. After test and analysis, proposed method’s R-squared reaches 0.974, all indicators of error are minimal. Therefore, it is better than the existing methods. The work of this research has great significance for the maintenance and operation of power system.},
booktitle = {Advanced Intelligent Computing Technology and Applications: 19th International Conference, ICIC 2023, Zhengzhou, China, August 10–13, 2023, Proceedings, Part IV},
pages = {165–175},
numpages = {11},
keywords = {Electric load, Time series, Deep learning},
location = {Zhengzhou, China}
}

@inproceedings{10.1145/3659677.3659713,
author = {Ben Halima, Anouar and Yzzogh, Hicham and Benaboud, Hafssa},
title = {Predictive Load Balancing in Cloud Computing: A Comparative Study},
year = {2024},
isbn = {9798400709296},
