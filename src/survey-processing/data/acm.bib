author = {Anh, Nguyen Thi Ngoc and Anh, Nguyen Nhat and Thang, Tran Ngoc and Solanki, Vijender Kumar and Crespo, Rub\'{e}n Gonz\'{a}lez and Dat, Nguyen Quang},
title = {Online SARIMA applied for short-term electricity load forecasting},
